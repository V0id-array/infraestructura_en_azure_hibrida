#!/usr/bin/env bash


# --- Variables Generales y Proyecto ---
export PROJECT_NAME="empresa-az"
export ENVIRONMENT="prod"
export LOCATION="westeurope"
export RANDOM_SUFFIX="$(openssl rand -hex 3 2>/dev/null || echo "1a2b3c")"
export RESOURCE_GROUP="rg-${PROJECT_NAME}-${ENVIRONMENT}-${LOCATION}"

# --- Nombres de Red (Hub-Spoke) ---
export HUB_VNET_NAME="vnet-hub-${LOCATION}"
export HUB_VNET_PREFIX="10.0.0.0/16"

export WOO_VNET_NAME="vnet-woocommerce-${LOCATION}"
export WOO_VNET_PREFIX="10.1.0.0/16"

export CORP_VNET_NAME="vnet-corporate-${LOCATION}"
export CORP_VNET_PREFIX="10.2.0.0/16"

# Subredes Hub
export HUB_SNET_FW_PREFIX="10.0.1.0/26"
export HUB_SNET_GW_PREFIX="10.0.2.0/27"
export HUB_SNET_BASTION_PREFIX="10.0.3.0/26"
export HUB_SNET_MGMT_PREFIX="10.0.4.0/24"
export HUB_SNET_MGMT_NAME="snet-management"

# Subredes Spoke WooCommerce
export WOO_SNET_AKS_PREFIX="10.1.1.0/24"
export WOO_SNET_AKS_NAME="snet-aks-nodes"
export WOO_SNET_DB_PREFIX="10.1.10.0/24"
export WOO_SNET_DB_NAME="snet-database"
export WOO_SNET_CACHE_PREFIX="10.1.11.0/24"
export WOO_SNET_CACHE_NAME="snet-cache"

# Subredes Spoke Corporate
export CORP_SNET_STORAGE_PREFIX="10.2.1.0/24"
export CORP_SNET_STORAGE_NAME="snet-storage"
export CORP_SNET_PURVIEW_PREFIX="10.2.2.0/24"
export CORP_SNET_PURVIEW_NAME="snet-purview"
export CORP_SNET_KV_PREFIX="10.2.3.0/24"
export CORP_SNET_KV_NAME="snet-keyvault"

# --- Pilar 1: Seguridad y Monitorización ---
export LAW_NAME="law-central-${PROJECT_NAME}-${RANDOM_SUFFIX}"
export KV_NAME="kv-${PROJECT_NAME}-${RANDOM_SUFFIX}"

# --- Pilar 2: Almacenamiento Corporativo ---
export STORAGE_ACCOUNT_NAME="stcorp${RANDOM_SUFFIX}"
export FILE_SHARE_NAME="share-corporate"
export PURVIEW_ACCOUNT_NAME="purview-corp-${RANDOM_SUFFIX}"

# --- Pilar 4: WooCommerce (AKS, ACR, MySQL, Redis) ---
export ACR_NAME="acrwoo${RANDOM_SUFFIX}"
export AKS_CLUSTER_NAME="aks-woo-${ENVIRONMENT}"
export AKS_NODE_COUNT=2
export AKS_VM_SIZE="Standard_D2s_v3"
export MYSQL_SERVER_NAME="mysql-woo-${PROJECT_NAME}-${RANDOM_SUFFIX}"
export MYSQL_ADMIN_USER="dbadmin"
export MYSQL_ADMIN_PASS="ChangeMe123456!"
export REDIS_NAME="redis-woo-${PROJECT_NAME}-${RANDOM_SUFFIX}"

# --- Pilar 5: Active Directory (Windows Server VMs HA) ---
export AD_DOMAIN_NAME="corp.local"
export AD_NETBIOS_NAME="CORP"
export AD_VM_SIZE="Standard_D2s_v3"
export AD_ADMIN_USER="adadmin"
export AD_ADMIN_PASS="P@ssw0rd2026!Secure"
export AD_DC1_NAME="vm-dc-01"
export AD_DC2_NAME="vm-dc-02"
export AD_ILB_NAME="lb-dc-internal"
export AD_ILB_IP="10.0.4.9"

# --- Pilar 6: Copias de Seguridad ---
export RSV_NAME="rsv-central-${PROJECT_NAME}-${RANDOM_SUFFIX}"
export BACKUP_POLICY_VM="policy-backup-cloud-vms"
export BACKUP_POLICY_FILES="policy-backup-fileshare"

# --- Etiquetas (Tags) ---
export TAGS="Proyecto=${PROJECT_NAME} Entorno=${ENVIRONMENT} GestionadoPor=az-cli"
