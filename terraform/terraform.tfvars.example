#===============================================================================
# Terraform - Ejemplo de terraform.tfvars
# Copia este archivo como terraform.tfvars y rellena los valores.
#===============================================================================

project_name = "enterprise"
environment  = "prod"
location     = "westeurope"

tags = {
  Proyecto    = "InfraestructuraEmpresarial"
  ManagedBy   = "Terraform"
  Empresa     = "MiEmpresa"
  Responsable = "equipo-infra"
}

# ─── Networking ───────────────────────────────────────────────────────────────
hub_vnet_address_space         = ["10.0.0.0/16"]
woocommerce_vnet_address_space = ["10.1.0.0/16"]
corporate_vnet_address_space   = ["10.2.0.0/16"]

