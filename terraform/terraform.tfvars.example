# ─── WooCommerce / AKS ───────────────────────────────────────────────────────
aks_node_count       = 2
aks_node_vm_size     = "Standard_D2s_v3"
mysql_sku_name       = "B_Standard_B1ms"
mysql_admin_username = "woo_admin"
mysql_admin_password = "CAMBIA_ESTA_CONTRASEÑA_SEGURA!"

# ─── Purview ──────────────────────────────────────────────────────────────────
purview_managed_rg_name = "rg-purview-managed"

# ─── Azure Arc ────────────────────────────────────────────────────────────────
arc_enabled = true
